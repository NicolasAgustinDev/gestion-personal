<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="1" author="nicolas">
        <addColumn tableName="categoria">
            <column name="sueldo" type="DECIMAL(10,2)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2" author="nicolas">
        <addColumn tableName="categoria">
            <column name="estado" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="010-create-table-usuario" author="nicolas">

        <createTable tableName="usuario">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_usuario"
                             nullable="false"/>
            </column>

            <column name="nombre" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="apellido" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="rol" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="estado" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>

        </createTable>

    </changeSet>

</databaseChangeLog>